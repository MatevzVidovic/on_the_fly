
# Staging PostgreSQL (source)
STAG_USER=myuser
STAG_PASSWORD=mypassword
STAG_HOST=localhost
STAG_PORT=5432
STAG_DATABASE=fmp_data_gurs

# Production PostgreSQL (destination)
PROD_USER=myuser
PROD_PASSWORD=mypassword
PROD_HOST=localhost
PROD_PORT=5432
PROD_DATABASE=fmp_data_gurs

# PostgreSQL schema containing the tables to synchronise.
# This defaults to fmp_data_gurs if omitted.
SYNC_SCHEMA=fmp_data_gurs
