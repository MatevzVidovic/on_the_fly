# Staging PostgreSQL (source)
STAG_USER=myuser
STAG_PASSWORD=mypassword
STAG_HOST=localhost
STAG_PORT=5432
STAG_DATABASE=fmp_data_gurs

# Production PostgreSQL (destination)
PROD_USER=myuser
PROD_PASSWORD=mypassword
PROD_HOST=localhost
PROD_PORT=5432
PROD_DATABASE=fmp_data_gurs

# Both tables are normally in public.
SYNC_SCHEMA=public
