# LIFT staging PostgreSQL. The tool uses both databases on this PostgreSQL
# service: metadata in fmp and data tables in fmp_data_gurs.
STAG_USER=myuser
STAG_PASSWORD=mypassword
STAG_HOST=localhost
STAG_PORT=5432
STAG_DATABASE=fmp_data_gurs
STAG_METADATA_DATABASE=fmp

# Optional production equivalent, used only with --environment prod.
PROD_USER=myuser
PROD_PASSWORD=mypassword
PROD_HOST=localhost
PROD_PORT=5432
PROD_DATABASE=fmp_data_gurs
PROD_METADATA_DATABASE=fmp
