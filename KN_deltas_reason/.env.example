# KN Oracle source
KN_USER=scott
KN_PASSWORD=tiger
KN_HOST=localhost
KN_PORT=10522
KN_SERVICE=EPRO.cman.prim
# Connection setup bound for both PostgreSQL and Oracle clients (default: 15).
KN_AUDIT_CONNECT_TIMEOUT_SECONDS=15
# Required only when KN requires native encryption.
# KN_ORACLE_CLIENT_LIB_DIR=/opt/oracle/instantclient

# LIFT staging PostgreSQL
STAG_USER=myuser
STAG_PASSWORD=mypassword
STAG_HOST=localhost
STAG_PORT=5432
STAG_DATABASE=fmp_data_gurs
# LIFT integration metadata (`attribute_tables`, integrations, translations).
STAG_METADATA_DATABASE=fmp

# LIFT test PostgreSQL (the default profile)
TEST_USER=my_user
TEST_PASSWORD=mypassword
TEST_HOST=localhost
TEST_PORT=5432
TEST_DATABASE=fmp_data_gurs
