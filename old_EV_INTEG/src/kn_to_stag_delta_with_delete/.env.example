# KN Oracle database (source)
KN_USER=scott
KN_PASSWORD=tiger
KN_HOST=oracle-host.example.com
KN_PORT=1521
KN_SERVICE=ORCLPDB1

KN_ORACLE_CLIENT_LIB_DIR=/Users/matevzvidovic/Downloads/instantclient_23_26

# Required when KN enforces Oracle Native Network Encryption/Data Integrity.
# Point this at the Oracle Instant Client directory containing libclntsh.dylib
# (macOS) or libclntsh.so (Linux). Leave unset only when thin mode is allowed.
# KN_ORACLE_CLIENT_LIB_DIR=/opt/oracle/instantclient_23_3

# Staging PostgreSQL database (destination)
STAG_USER=myuser
STAG_PASSWORD=mypassword
STAG_HOST=localhost
STAG_PORT=5432
STAG_DATABASE=fmp_data_gurs

# PostgreSQL schema containing the staging tables.
# This defaults to public if omitted.
STAG_SCHEMA=public
